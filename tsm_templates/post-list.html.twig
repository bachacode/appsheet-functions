<style>
	.tsm-container {
		width: 100%;
	}

	@media (min-width: 640px) {
		.tsm-container {
			max-width: 640px;
		}
	}
	@media (min-width: 768px) {
		.tsm-container {
			max-width: 768px;
		}
	}
	@media (min-width: 1024px) {
		.tsm-container {
			max-width: 1024px;
		}
	}
	@media (min-width: 1280px) {
		.tsm-container {
			max-width: 1280px;
		}
	}
	@media (min-width: 1536px) {
		.tsm-container {
			max-width: 1536px;
		}
	}

	.tsm-post-list__wrapper {
		display: grid;
		width: 100%;
	}

	.tsm-post-list-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
	}

	.tsm-post-list-link-content {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.tsm-post-list-card__image {
		width: 100%;
		overflow: hidden;
	}

	.tsm-post-list-card__image img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.tsm-content {
		display: flex;
		flex-direction: column;
		flex: 1;
		height: 100%;
	}

	.tsm-content-title__wrapper {
		margin-bottom: 0.5rem;
	}

	.tsm-content-category__wrapper {
		margin-bottom: 0.5rem;
	}

	.tsm-content-excerpt__wrapper {
		flex: 1;
		margin-bottom: 0.5rem;
	}

	.tsm-content-read-more {
		margin-top: auto;
	}

	/* Add transition for smooth animations */
	.tsm-container * {
		transition: all 0.3s ease;
	}

	.tsm-post-list-link:hover {
		transform: translateY(-5px);
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
	}

	/* Hide Alpine.js content until it's ready */
	[x-cloak] {
		display: none !important;
	}

	.tsm-search-wrapper {
		margin-bottom: 1.5rem;
	}

	.tsm-search-container {
		position: relative;
		width: 100%;
	}

	.tsm-search-input {
		width: 100%;
		padding: 0.75rem 2.5rem 0.75rem 1rem;
	}

	.tsm-search-icon {
		position: absolute;
		right: 1rem;
		top: 50%;
		transform: translateY(-50%);
	}
</style>

{# Server-side rendered content #}
<div class="tsm-container" x-data="postList_{{ unique_id }}()">
	<div class="tsm-search-wrapper">
		<div class="tsm-search-container">
			<input 
				type="text" 
				class="tsm-search-input" 
				placeholder="{{ settings.tsm_search_placeholder }}" 
				x-model="searchQuery"
			>
			<i class="fas fa-search tsm-search-icon"></i>
		</div>
	</div>
	<div class="tsm-post-list__wrapper" x-ref="postsContainer">
		{% for post in posts %}
			<a href="{{ post.link }}" class="tsm-post-list-link">
				<div class="tsm-post-list-link-content">
					{% if settings.tsm_post_list_show_image == 'yes' and post.thumbnail %}
						<div class="tsm-post-list-card__image">
							<img src="{{ post.thumbnail }}" alt="{{ post.title }}">
						</div>
					{% endif %}
					<div class="tsm-content">
						{% if settings.tsm_post_list_show_title == 'yes' %}
							<div class="tsm-content-title__wrapper">
								<span class="tsm-content-title">{{ post.title }}</span>
							</div>
						{% endif %}
						{% if settings.tsm_post_list_show_category == 'yes' and post.category_slug %}
							<div class="tsm-content-category__wrapper">
								<span class="tsm-content-category">
									{% if settings.tsm_post_list_category_show_icon == 'yes' %}
										<i class="{{ settings.tsm_post_list_category_icon.value }}"></i>
									{% endif %}
									<span>{{ post.category_name }}</span>
								</span>
							</div>
						{% endif %}
						{% if settings.tsm_post_list_show_excerpt == 'yes' %}
							<div class="tsm-content-excerpt__wrapper">
								<span class="tsm-content-excerpt">{{ post.excerpt }}</span>
							</div>
						{% endif %}
						{% if settings.tsm_post_list_show_read_more == 'yes' %}
							<div class="tsm-content-read-more__wrapper">
								<span class="tsm-content-read-more">{{ settings.tsm_post_list_read_more_text }}</span>
							</div>
						{% endif %}
					</div>
				</div>
			</a>
		{% endfor %}
	</div>
</div>

<script>
function postList_{{ unique_id }}() {
	return {
		posts: {{ posts|json_encode|raw }},
		settings: {{ settings|json_encode|raw }},
		searchQuery: '',
		
		init() {
			// Watch for changes in search query
			this.$watch('searchQuery', () => this.filterPosts());
		},
		
		filterPosts() {
			const query = this.searchQuery.toLowerCase();
			const posts = this.$refs.postsContainer.querySelectorAll('.tsm-post-list-link');
			
			posts.forEach(post => {
				const title = post.querySelector('.tsm-content-title')?.textContent.toLowerCase() || '';
				const excerpt = post.querySelector('.tsm-content-excerpt')?.textContent.toLowerCase() || '';
				const category = post.querySelector('.tsm-content-category span:last-child')?.textContent.toLowerCase() || '';
				
				const matches = 
					title.includes(query) ||
					excerpt.includes(query) ||
					category.includes(query);
				
				post.style.display = matches ? '' : 'none';
			});
		}
	}
}
</script> 