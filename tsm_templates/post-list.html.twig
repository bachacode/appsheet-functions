<div class="tsm-main__wrapper">
	<div class="tsm-container" x-data="postList_{{ unique_id }}()">
		{# Sidebar #}
		<div class="tsm-sidebar">
			<div class="tsm-post-count">
				<strong x-text="filteredPosts.length">{{ posts|length }}</strong> resultados.
			</div>

			{% if categories != [] %}
			<ul class="tsm-categories-list">
				{% for terms in categories %}
					<h3 class="tsm-categories-list__title">{{ terms.title }}</h3>
					{% for term in terms.taxonomy_list %}
					<li class="tsm-categories-list__item">
						<label class="tsm-categories-list__link">
							<input 
								type="checkbox" 
								class="tsm-categories-list__checkbox" 
								@click="filterByCategory('{{ term.slug }}')"
								:checked="selectedCategories.has('{{ term.slug }}')"
							>
							<span class="tsm-categories-list__name">{{ term.name }}</span>
						</label>
					</li>
					{% endfor %}
				{% endfor %}
			</ul>
			{% endif %}
		</div>

		{# Main content #}
		<div class="tsm-main-content">
			<div class="tsm-search-wrapper">
				<div class="tsm-search-container">
					<input 
						type="text" 
						class="tsm-search-input" 
						placeholder="{{ settings.tsm_search_placeholder }}" 
						x-model="searchQuery"
					>
					<i class="fas fa-search tsm-search-icon"></i>
				</div>
			</div>

			<div class="tsm-post-list__wrapper" x-ref="postsContainer">
				{% for post in posts %}
					<div class="tsm-post-list-element" data-terms='{{ post.terms|json_encode }}' data-taxonomies='{{ post.taxonomies|json_encode }}'>
						{% if settings.tsm_post_list_whole_post_linkable == 'yes' %}
							<a href="{{ post.link }}" class="tsm-post-list-full-link" aria-label="{{ post.title }}"></a>
						{% endif %}
						<div class="tsm-post-list-element-content">
							{% if settings.tsm_post_list_show_image == 'yes' and post.thumbnail %}
								<a href="{{ post.link }}" class="tsm-post-list-card__image">
									<img src="{{ post.thumbnail }}" alt="{{ post.title }}">
								</a>
							{% endif %}
							<div class="tsm-content">
								{% if settings.tsm_post_list_show_title == 'yes' %}
									<div class="tsm-content-title__wrapper">
										<a href="{{ post.link }}" class="tsm-content-title">{{ post.title }}</a>
									</div>
								{% endif %}
								{% if settings.tsm_post_list_show_category == 'yes' and post.main_taxonomy %}
									<div class="tsm-content-category__wrapper">
										<span class="tsm-content-category">
											{% if settings.tsm_post_list_category_show_icon == 'yes' %}
												<i class="{{ settings.tsm_post_list_category_icon.value }}"></i>
											{% endif %}
											<span>{{ post.main_taxonomy }}</span>
										</span>
									</div>
								{% endif %}
								{% if settings.tsm_post_list_show_excerpt == 'yes' %}
									<div class="tsm-content-excerpt__wrapper">
										<span class="tsm-content-excerpt">{{ post.excerpt }}</span>
									</div>
								{% endif %}
								{% if settings.tsm_post_list_show_read_more == 'yes' %}
									<div class="tsm-content-read-more__wrapper">
										<a href="{{ post.link }}" class="tsm-content-read-more">{{ settings.tsm_post_list_read_more_text }}</a>
									</div>
								{% endif %}
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	</div>
</div>

<script>
function postList_{{ unique_id }}() {
	return {
		posts: {{ posts|json_encode|raw }},
		settings: {{ settings|json_encode|raw }},
		searchQuery: '',
		selectedCategories: new Set(),
		
		init() {
			// Watch for changes in search query
			this.$watch('searchQuery', () => this.filterPosts());
		},

		get filteredPosts() {
			const query = this.searchQuery.toLowerCase();
			return this.posts.filter(post => {
				const matchesSearch = post.title.toLowerCase().includes(query);
				const matchesCategory = this.selectedCategories.size === 0 || 
					post.taxonomy_slugs.some(slug => this.selectedCategories.has(slug));
				return matchesSearch && matchesCategory;
			});
		},
		
		filterPosts() {
			const posts = this.$refs.postsContainer.querySelectorAll('.tsm-post-list-element');
			const query = this.searchQuery.toLowerCase();
			
			posts.forEach(post => {
				const title = post.querySelector('.tsm-content-title')?.textContent.toLowerCase() || '';
				const terms = JSON.parse(post.getAttribute('data-terms'));
				
				const matchesSearch = title.includes(query);
				const matchesCategory = this.selectedCategories.size === 0 || 
					terms.some(term => this.selectedCategories.has(term));
				
				post.style.display = (matchesSearch && matchesCategory) ? '' : 'none';
			});
		},

		filterByCategory(category) {
			// Toggle category in Set
			if (this.selectedCategories.has(category)) {
				this.selectedCategories.delete(category);
			} else {
				this.selectedCategories.add(category);
			}
			
			this.filterPosts();
		}
	}
}
</script> 